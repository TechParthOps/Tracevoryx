# Tracevoryx environment configuration (placeholders ONLY - never commit
# real secrets). Copy to .env (git-ignored) or set as process environment
# variables. Precedence: environment > config/settings.json > defaults.

# Log level: DEBUG | INFO | WARNING | ERROR
TW_LOG_LEVEL=INFO

# API binding: loopback by default. Remote listening requires explicit
# configuration + TLS + firewall understanding. Do not expose the dashboard
# or gateway directly to the internet.
TW_API_HOST=127.0.0.1
TW_API_PORT=8640

# Rate limits (requests/minute per identity)
TW_API_RATE_PER_MIN=300
TW_API_MCP_RATE_PER_MIN=120

# Request body cap (MB) - applies to Content-Length AND streamed bodies
TW_API_MAX_BODY_MB=200

# Pipeline
TW_PIPELINE_MAX_QUEUE=5000

# Runtime state (shadow/enforce choice) persists to data/runtime_state.json
# at runtime, so restarts preserve the operator's choice.
